# URL pública de la aplicación y telemetría pública (solo datos públicos)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=

# Neon PostgreSQL principal (SOLO servidor — NUNCA usar prefijo NEXT_PUBLIC_)
# DATABASE_URL: conexión pooled (-pooler) usada por Next.js en runtime
# DIRECT_DATABASE_URL: conexión directa (sin -pooler) usada por `npm run db:migrate` y `npm run db:seed`
DATABASE_URL=
DIRECT_DATABASE_URL=

# Better Auth sobre Neon PostgreSQL (SOLO servidor)
# Generar secreto: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon Object Storage (S3-compatible, SOLO servidor — opcional para avatares)
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=student-avatars
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_PUBLIC_BASE_URL=

# Server-only & CI/Build secrets (NUNCA usar prefijo NEXT_PUBLIC_)
GEMINI_API_KEY=
MAILTRAP_API_TOKEN=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
